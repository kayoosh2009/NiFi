style title{
	text-color: #ffffff;
	text-size: 32;
	text-stroke-color: #000000;
}

style main{
	background-color: #dddddd;
	stroke-color: #000000;
	text-color: #ffffff;
	text-size: 24;
}

object text{
	id: theWonNum;
	style: title;
	location{
		set-x: 20;
		set-y: 20;
	}
	text{ "The number: {number} won!" }
}

object button{
	id: play_button;
	style: main;
	location{
		align: center;
		width: 50;
		height: 50;
	}
	text{ "Play" }
}